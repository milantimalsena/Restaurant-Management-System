<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Smart Restaurant Management</display-name>

    <!-- Session timeout handling -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Customer Authentication Servlets -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.restaurant.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.restaurant.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.restaurant.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Admin Authentication Servlet -->
    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.restaurant.controller.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin/login</url-pattern>
    </servlet-mapping>

    <!-- Menu Module: Customer -->
    <servlet>
        <servlet-name>MenuServlet</servlet-name>
        <servlet-class>com.restaurant.controller.MenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MenuServlet</servlet-name>
        <url-pattern>/menu</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SearchMenuServlet</servlet-name>
        <servlet-class>com.restaurant.controller.SearchMenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SearchMenuServlet</servlet-name>
        <url-pattern>/menu/search</url-pattern>
    </servlet-mapping>

    <!-- Menu Module: Admin -->
    <servlet>
        <servlet-name>ManageMenuServlet</servlet-name>
        <servlet-class>com.restaurant.controller.ManageMenuServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageMenuServlet</servlet-name>
        <url-pattern>/admin/manage-menu</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddMenuItemServlet</servlet-name>
        <servlet-class>com.restaurant.controller.AddMenuItemServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddMenuItemServlet</servlet-name>
        <url-pattern>/admin/add-menu-item</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditMenuItemServlet</servlet-name>
        <servlet-class>com.restaurant.controller.EditMenuItemServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditMenuItemServlet</servlet-name>
        <url-pattern>/admin/edit-menu-item</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteMenuItemServlet</servlet-name>
        <servlet-class>com.restaurant.controller.DeleteMenuItemServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteMenuItemServlet</servlet-name>
        <url-pattern>/admin/delete-menu-item</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ToggleAvailabilityServlet</servlet-name>
        <servlet-class>com.restaurant.controller.ToggleAvailabilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ToggleAvailabilityServlet</servlet-name>
        <url-pattern>/admin/toggle-availability</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryServlet</servlet-name>
        <servlet-class>com.restaurant.controller.CategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryServlet</servlet-name>
        <url-pattern>/admin/categories</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>public/home.jsp</welcome-file>
    </welcome-file-list>
</web-app>
